# ═══════════════════════════════════════════════════════════
#  GetForms — Production Self-Hosting Configuration
#  Copy this file: cp .env.example .env
#  Then edit .env with your real values.
# ═══════════════════════════════════════════════════════════

# Your domain (must point to this server's IP via DNS)
DOMAIN=forms.example.com

# ─── Database ───────────────────────────────────────────────
# Optional: PostgreSQL password (if using Docker Compose Postgres)
POSTGRES_PASSWORD=change_me_strong_password
# Optional: Set DATABASE_URL to use external PostgreSQL (omit to use zero-config SQLite)
# DATABASE_URL=postgresql://getforms:change_me_strong_password@localhost:5432/getforms

# ─── Auth ───────────────────────────────────────────────────
# Secret key for signing JWTs — generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# ─── Email (SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
# For Gmail: use an App Password (not your main password)
# https://myaccount.google.com/apppasswords
SMTP_PASS=your-app-password
FROM_EMAIL=GetForms <noreply@forms.example.com>

# ─── Uploads ────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ─── Logging ────────────────────────────────────────────────
# Options: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
