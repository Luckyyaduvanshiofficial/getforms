# GetForms Backend — Configuration
# Copy: cp .env.example .env
# Then fill in your values.

# Optional: PostgreSQL connection string (defaults to SQLite ./data/getform.db if omitted)
# DATABASE_URL=postgresql://getforms:localdev@localhost:5432/getforms

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change-me-at-least-32-chars-long

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# SMTP (optional — can also be configured per-account in the UI)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=GetForms <noreply@localhost>

# File upload size limit in MB
MAX_FILE_SIZE_MB=10

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
